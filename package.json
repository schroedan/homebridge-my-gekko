{
  "name": "homebridge-my-gekko",
  "version": "0.5.0",
  "description": "myGEKKO Platform Plugin for Homebridge",
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "my-gekko",
    "mygekko",
    "supports-hap"
  ],
  "main": "dist/main.js",
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint src/**.ts --max-warnings=0",
    "prepublishOnly": "npm run build",
    "start": "npm run build && npm link && nodemon",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "author": "Daniel Schröder <daniel.schroeder@skriptfabrik.com>",
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^22.10.0 || ^24.0.0"
  },
  "license": "ISC",
  "files": [
    "config.schema.json",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/schroedan/homebridge-my-gekko.git"
  },
  "bugs": {
    "url": "http://github.com/schroedan/homebridge-my-gekko/issues"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "axios-cache-interceptor": "^1.12.3",
    "axios-retry": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.12.1",
    "homebridge": "^2.4.0",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  }
}
